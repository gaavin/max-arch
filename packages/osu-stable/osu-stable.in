#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -eq 0 ]; then
  echo "osu-stable: refuse to run as root (userdata would be owned by root)." >&2
  echo "Run as your normal user — never sudo/osu-stable." >&2
  exit 1
fi

export WINELLO_PACKAGED=1
export WINELLO_ROOT="${WINELLO_ROOT:-/usr/share/osu-stable}"
export WINE_INSTALL_PATH="${WINE_INSTALL_PATH:-/opt/wine-osu}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export BINDIR="${BINDIR:-$HOME/.local/bin}"
export YAWL_INSTALL_PATH="${YAWL_INSTALL_PATH:-$XDG_DATA_HOME/osuconfig/yawl}"
export WINE="${WINE:-$XDG_DATA_HOME/osuconfig/yawl-winello}"
export WINESERVER="${WINESERVER:-${WINE}server}"

mkdir -p "$XDG_DATA_HOME/osuconfig"
if [ ! -e "$XDG_DATA_HOME/osuconfig/update" ]; then
  ln -sfn "$WINELLO_ROOT" "$XDG_DATA_HOME/osuconfig/update"
elif [ -d "$XDG_DATA_HOME/osuconfig/update/.git" ]; then
  rm -rf "$XDG_DATA_HOME/osuconfig/update"
  ln -sfn "$WINELLO_ROOT" "$XDG_DATA_HOME/osuconfig/update"
fi

# Keep a home-local handler binary (pressure-vessel / yawl enter can see $HOME)
if [ ! -x "$XDG_DATA_HOME/osuconfig/osu-handler-wine" ]; then
  install -Dm755 "$WINELLO_ROOT/stuff/osu-handler-wine" \
    "$XDG_DATA_HOME/osuconfig/osu-handler-wine" 2>/dev/null || true
fi

winello_needs_setup() {
  [ ! -r "$XDG_DATA_HOME/wineprefixes/osu-wineprefix/system.reg" ] && return 0
  [ ! -r "$XDG_DATA_HOME/osuconfig/osupath" ] && return 0
  return 1
}

if winello_needs_setup; then
  echo -e '\033[1;34mWinello:\033[0m First run — setting up...'
  bash "$WINELLO_ROOT/osu-winello.sh"
  if winello_needs_setup; then
    echo -e '\033[1;31mWinello:\033[0m Setup failed.' >&2
    exit 1
  fi
fi

is_osu_handler_arg() {
  case "${1:-}" in
    osu://* | *.osr | *.osz | *.osk | *.osz2) return 0 ;;
    *) return 1 ;;
  esac
}

# Bare file/URL args → handler path (desktop entries use --osuhandler explicitly)
if [ "${1:-}" != "--osuhandler" ] && is_osu_handler_arg "${1:-}"; then
  set -- --osuhandler "$@"
fi

exec bash "$WINELLO_ROOT/osu-wine" "$@"
