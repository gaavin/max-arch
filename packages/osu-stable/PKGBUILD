prepare() {
  cd "${srcdir}/osu-winello-${_winello_commit}"
  patch -Np1 -i "${srcdir}/arch-packaged-mode.patch"
  rm -f stuff/cabextract
  chmod +x osu-wine osu-winello.sh stuff/osu-handler-wine stuff/folderfixosu
}

package_wine-osu-stable() {
  pkgdesc='Patched wine-osu (wow64) for osu-stable'
  depends=()
  provides=('wine-osu')
  conflicts=('wine-osu')
  options=('!strip')

  install -d "${pkgdir}/opt"
  cp -a "${srcdir}/wine-osu" "${pkgdir}/opt/wine-osu"
}

package_osu-stable-prefix() {
  pkgdesc='Prebuilt Wineprefix template for osu-stable'
  arch=(any)
  depends=('wine-osu-stable')
  options=('!strip')

  install -Dm644 "${srcdir}/osu-winello-prefix.tar.xz" \
    "${pkgdir}/usr/share/osu-stable/osu-winello-prefix.tar.xz"
}

package_osu-stable() {
  pkgdesc='osu! stable launcher (based on osu-winello)'
  depends=(
    'wine-osu-stable'
    'osu-stable-prefix'
    'bash'
    'curl'
    'wget'
    'unzip'
    'zenity'
    'git'
    'procps-ng'
    'coreutils'
    'cabextract'
    'xdg-utils'
    'shared-mime-info'
    'desktop-file-utils'
    'xdg-desktop-portal-gtk'
  )
  optdepends=(
    'pipewire: recommended low-latency audio'
    'winetricks: recreate prefix manually (osu-stable --fixprefix)'
    'gamemode: set PRE_LAUNCH_ARGS=gamemoderun in config'
    'mangohud: set PRE_LAUNCH_ARGS=mangohud in config'
    'opentabletdriver: tablet support'
  )
  install=osu-stable.install
  provides=('osu-mime')
  conflicts=('osu-mime')

  local _src="${srcdir}/osu-winello-${_winello_commit}"
  local _share="${pkgdir}/usr/share/osu-stable"

  install -d "${_share}/stuff"

  install -Dm755 "${_src}/osu-winello.sh" "${_share}/osu-winello.sh"
  install -Dm755 "${_src}/osu-wine" "${_share}/osu-wine"

  install -Dm755 "${_src}/stuff/osu-handler-wine" "${_share}/stuff/osu-handler-wine"
  install -Dm755 "${_src}/stuff/folderfixosu" "${_share}/stuff/folderfixosu"
  install -Dm644 "${_src}/stuff/folderfixosu.vbs" "${_share}/stuff/folderfixosu.vbs"
  install -Dm644 "${_src}/stuff/osu-handler.reg" "${_share}/stuff/osu-handler.reg"
  install -Dm644 "${_src}/stuff/example.cfg" "${_share}/stuff/example.cfg"
  install -Dm644 "${_src}/stuff/winello-default.cfg" "${_share}/stuff/winello-default.cfg"
  install -Dm644 "${_src}/stuff/osu-wine.png" "${_share}/stuff/osu-wine.png"

  install -Dm755 "${srcdir}/yawl-${_yawl_ver}" "${pkgdir}/usr/lib/osu-stable/yawl"

  install -Dm755 "${srcdir}/osu-stable.in" "${pkgdir}/usr/bin/osu-stable"

  install -Dm644 "${srcdir}/osu-stable.desktop" \
    "${pkgdir}/usr/share/applications/osu-stable.desktop"
  install -Dm644 "${srcdir}/osu-stable-file-handler.desktop" \
    "${pkgdir}/usr/share/applications/osu-stable-file-handler.desktop"
  install -Dm644 "${srcdir}/osu-stable-url-handler.desktop" \
    "${pkgdir}/usr/share/applications/osu-stable-url-handler.desktop"

  install -Dm644 "${_src}/stuff/osu-wine.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/osu-stable.png"
  install -Dm644 "${_src}/stuff/osu-wine.png" \
    "${pkgdir}/usr/share/pixmaps/osu-stable.png"

  tar -xzf "${srcdir}/osu-mime.tar.gz" -C "${srcdir}"
  install -Dm644 "${srcdir}/osu-mime/osu-file-extensions.xml" \
    "${pkgdir}/usr/share/mime/packages/osu-file-extensions.xml"
}
