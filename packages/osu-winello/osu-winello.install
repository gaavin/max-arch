post_install() {
  update-desktop-database -q >/dev/null 2>&1 || true
  update-mime-database /usr/share/mime >/dev/null 2>&1 || true
  echo 'osu-winello installed. Run: osu-wine'
}

post_upgrade() {
  post_install
}

post_remove() {
  update-desktop-database -q >/dev/null 2>&1 || true
  update-mime-database /usr/share/mime >/dev/null 2>&1 || true
}
