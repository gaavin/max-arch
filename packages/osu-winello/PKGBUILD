# Maintainer: Max Power <me@gavinpower.dev>
# Upstream: https://github.com/NelloKudo/osu-winello

pkgbase=osu-winello
pkgname=(
  osu-winello
  wine-osu-winello
  osu-winello-prefix
)
pkgver=11.12.1
pkgrel=2
pkgdesc='osu! stable on Linux via winello (patched wine-osu + yawl)'
arch=(x86_64)
url='https://github.com/NelloKudo/osu-winello'
license=('GPL-3.0-or-later' 'LGPL-2.1-or-later')
options=(!strip)

_wine_tag=11.12-1
_yawl_ver=0.8.2
_winello_commit=c7dde4db31889c037d63d9de1722725423de8bf6

source=(
  "osu-winello-${_winello_commit}.tar.gz::https://github.com/NelloKudo/osu-winello/archive/${_winello_commit}.tar.gz"
  "wine-osu-winello-fonts-wow64-${_wine_tag}-x86_64.tar.xz::https://github.com/NelloKudo/WineBuilder/releases/download/wine-osu-staging-${_wine_tag}/wine-osu-winello-fonts-wow64-${_wine_tag}-x86_64.tar.xz"
  "yawl-${_yawl_ver}::https://github.com/whrvt/yawl/releases/download/v${_yawl_ver}/yawl"
  "osu-winello-prefix.tar.xz::https://github.com/NelloKudo/osu-winello/releases/download/winello-bins/osu-winello-prefix.tar.xz"
  "osu-mime.tar.gz::https://github.com/NelloKudo/osu-winello/releases/download/winello-bins/osu-mime.tar.gz"
  'osu-wine.desktop'
  'osu-winello.install'
  'arch-packaged-mode.patch'
  'osu-wine.in'
  'osuwinello-file-extensions-handler.desktop'
  'osuwinello-url-handler.desktop'
)
noextract=(
  'osu-winello-prefix.tar.xz'
  'osu-mime.tar.gz'
  "yawl-${_yawl_ver}"
)
sha256sums=(
  '240eb6df455fdab7ca1816171d02108a108a894f91738a534aee17037310f881'
  'ff84811432f8230fa5b1aaa52c12321fa06c949e33e6b862e37743f9eba7b708'
  'bb8728d3ee8644d286324cff43cf8eee4c80fd95ead43229298706c2780f0e12'
  '009cfe18c144e16348b1aa7e3b561c793235a8591fb0b2affa5a2acea7682743'
  '8b7b562ce3a196e18b0e7c07518209b41ee74ce5af0473c9528777ebdd05cac5'
  'bc8f40f669cd0c3c66c257c28fb8ab52821051726674fa46bacbdcbebca29658'
  '7b9b496a883bbaea901879a19205951e2e3519197e02c5982d8d2854c8052909'
  'c82f5906d4d22a4252d3e11d8cfde1b8b76799823996250f66657fd1664cc3f4'
